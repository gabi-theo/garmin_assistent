# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/health_db # Async SQLAlchemy TimescaleDB connection string

# Redis Configuration
REDIS_URL=redis://redis:6379/0 # Connection URL for hot cache, locks, rate limits, and pub/sub

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092 # Kafka broker address for publishing and consuming telemetry metrics

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434 # Local Ollama service base URL
OLLAMA_MODEL=llama3 # LLM model name to run (e.g., llama3 or mistral)

# Security and Encryption
GARMIN_ENCRYPTION_KEY=S3cr3tKeyForGarminPasswordsAtRest32B= # 32-byte URL-safe base64-encoded AES key for Garmin password storage
SECRET_KEY=supersecretjwtandsessionhashkey # Secret key for cryptographic hashing or JWT signatures

# Poller Configuration
GARMIN_POLL_INTERVAL=300 # Polling frequency in seconds for checking new Garmin metrics per user (default 5 minutes)
